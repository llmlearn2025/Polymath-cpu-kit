+/* moe-knowledge: knowledge-expert packs (coli_kn.h). A swap drops the states a prompt could
+ * otherwise reuse: they were built under the old pack. */
+static void q36_kn_invalidate(void *mv) {
+    Model *m = mv;
+    kv_prefix_clear(&m->kvp);
+    if (g_q36_park.on) q36_park_free(m);
+}
+static void q36_kn_start(Model *m) {
+    const Cfg *c = &m->c;
+    ColiKnGeom g = {c->n_layers, c->hidden, c->inter, c->n_experts, c->topk, c->vocab};
+    if (c->muse || c->n_experts <= 0) g_kn_refuse = "knowledge packs need a routed MoE (not Muse Spark or a dense model)";
+#ifdef COLI_VULKAN
+    if (g_vk_chain) g_kn_refuse = "the Vulkan layer chain does not run knowledge experts (COLI_VK_CHAIN=0 runs them)";
+#endif
+    g_kn_invalidate = q36_kn_invalidate;
+    coli_kn_from_env(m, &g, "qwen36");
+}
